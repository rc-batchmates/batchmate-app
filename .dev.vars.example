BETTER_AUTH_SECRET="" # generate with: pnpm --filter @batchmate/auth exec better-auth secret

# RC OAuth app whose callback is registered for recurse.rocks (and localhost).
# Used for requests landing on those hosts.
# You can create an RC OAuth app for local dev at: https://www.recurse.com/settings/apps
RC_CLIENT_ID=""
RC_CLIENT_SECRET=""

# RC OAuth app whose callback is registered for batchmate.app. Used for
# requests landing on batchmate.app. Required even for local dev if you
# want to test the batchmate.app code path; otherwise the legacy creds
# above are fine for localhost.
RC_BATCHMATE_CLIENT_ID=""
RC_BATCHMATE_CLIENT_SECRET=""

BASE_URL="http://localhost:8787"

# Personal access token from recurse.com/settings/apps. Used to open the
# main entrance via https://doorbot.recurse.com/api/sesame/intercom.
DOORBOT_TOKEN=""

# Used only by `pnpm scrape:zoom` to resolve recurse.com/zoom/<slug>
# redirects. The chain hops through two auth domains, so paste the full
# `Cookie:` header value from a logged-in request on each (DevTools →
# Network → pick a same-domain request → Request Headers → Cookie).
# Never committed.
RC_SESSION_COOKIE=""           # from www.recurse.com
RC_TOGETHER_SESSION_COOKIE=""  # from recurse.rctogether.com

# pick randomish numbers above (not including) 256
# leave a bunch of zeros after your prefix, so rc ids (when added)
# won't collide
VIRTUAL_CARD_SITE_CODE = "998"
VIRTUAL_CARD_PREFIX = "99800000000"
