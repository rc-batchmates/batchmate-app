{
	"expo": {
		"name": "batchmate",
		"slug": "batchmate",
		"version": "1.2.0",
		"icon": "./assets/icon.png",
		"scheme": "batchmate",
		"userInterfaceStyle": "automatic",
		"backgroundColor": "#0A0F1C",
		"platforms": ["ios", "android"],
		"ios": {
			"bundleIdentifier": "app.batchmate.app",
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false,
				"LSApplicationQueriesSchemes": ["mailto"]
			},
			"associatedDomains": ["applinks:batchmate.app"],
			"appleTeamId": "KNBPD99JQM"
		},
		"android": {
			"package": "app.batchmate.app",
			"intentFilters": [
				{
					"action": "VIEW",
					"autoVerify": true,
					"data": [
						{
							"scheme": "https",
							"host": "batchmate.app",
							"pathPrefix": "/snack/"
						}
					],
					"category": ["BROWSABLE", "DEFAULT"]
				}
			],
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#0F172A"
			}
		},
		"plugins": [
			"expo-router",
			[
				"expo-build-properties",
				{
					"ios": {
						"newArchEnabled": true
					},
					"android": {
						"newArchEnabled": true
					}
				}
			],
			"expo-web-browser",
			[
				"react-native-nfc-manager",
				{
					"nfcPermission": "batchmate uses NFC to write and identify Snack Bar tags.",
					"includeNdefEntitlement": false
				}
			],
			"./plugins/with-snack-bar-nfc"
		],
		"experiments": {
			"autolinkingModuleResolution": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "40d6ad07-c63a-46ca-ad13-db4d8f87e38b"
			}
		},
		"owner": "leftshift",
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"updates": {
			"url": "https://u.expo.dev/40d6ad07-c63a-46ca-ad13-db4d8f87e38b"
		}
	}
}
